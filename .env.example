# Copy to .env.local for local development, and add the same three values
# in Netlify: Site configuration → Environment variables.

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key, or the newer "publishable" key (sb_publishable_...).
# NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Link opened by the "Explore Metr" button on the final screen (the main Metr system).
VITE_METR_MAIN_URL=
